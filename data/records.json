  "notes": [
    {
      "id": "N1",
      "observer": "周安",
      "run_hint": [
        "R1",
        "R2",
        "R3"
      ],
      "text": "升温后第一次全程没再抖，第二圈末了又顿了下，当时我已经接管。"
    },
    {
      "id": "N2",
      "observer": "俞礼",
      "run_hint": [
        "R2"
      ],
      "text": "后排在上环后半段没觉到之前那阵连颤，前半段我没注意。"
    },
    {
      "id": "N3",
      "observer": "金梁",
      "run_hint": [
        "R4",
        "R5"
      ],
      "text": "低坡转弯一直挺稳。后来那圈我说的顿，是旁车同事发来的，说他正降速。"
    },
    {
      "id": "N4",
      "observer": "谢晓",
      "run_hint": [
        "R6"
      ],
      "text": "二车手控上环跑完，无连颤。不是暖身阶段。"
    },
    {
      "id": "N5",
      "observer": "俞礼",
      "run_hint": [
        "R7"
      ],
      "text": "冰道转弯那会儿持续抖了两回，我在副驾，没接管。"
    },
    {
      "id": "N6",
      "observer": "周安",
      "run_hint": [
        "R2",
        "R3"
      ],
      "text": "刚才说第二圈的那回发生在接手以后。周安、俞礼登的是同一圈。"
    },
    {
      "id": "N7",
      "observer": "俞礼",
      "run_hint": [
        "R7"
      ],
      "text": "原来那句先把上环写成了低坡，V1 这次确实走上环。"
    },
    {
      "id": "N8",
      "observer": "周安",
      "run_hint": [
        "R8",
        "R9",
        "R10"
      ],
      "text": "旧四号午前上环连着抖了三次，下午只抖一次。新五号下午那圈比它轻，连颤一下便停了。"
    },
    {
      "id": "N9",
      "observer": "周安",
      "run_hint": [
        "R11",
        "R12"
      ],
      "text": "旧四号低坡连颤，新五号同段整圈未有连颤。"
    },
    {
      "id": "N10",
      "observer": "金梁",
      "run_hint": [
        "R9",
        "R10"
      ],
      "text": "下午“比它轻”说的是午前旧四号那种颤，和下午旧四号没在同一圈比。"
    },
    {
      "id": "N11",
      "observer": "周安",
      "run_hint": [
        "R12"
      ],
      "text": "新五号当时降速走，中间那一段没留意。请别把整圈都算成已观察。"
    }
  ],
